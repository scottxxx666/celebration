{
  "name": "celebration",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:tools": "uv run --with pillow python -m unittest discover -s tests/tools",
